{
  "compilerOptions": {
    "downlevelIteration": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "lib": ["ES2021.String"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "target": "ES2021",
    "declaration": false,
    "removeComments": true,
    "sourceMap": false,
    "importHelpers": true,
    "noEmitOnError": true,
    "noEmitHelpers": true,
    "incremental": false
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
