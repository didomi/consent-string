{
  "extends": "./base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "sourceMap": true,
    "lib": ["DOM"],
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
    },
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
