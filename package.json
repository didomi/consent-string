    "@rollup/plugin-typescript": "^11.1.6",
    "@sdk/typescript-config": "*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.4",
    "@types/dlv": "1.1.4",
    "@vitest/coverage-v8": "^2.0.5",
    "alias-hq": "6.2.4",
    "rollup": "4.22.0",
    "semantic-release": "^24.2.3",
    "typescript": "^5.6.2",
    "vitest": "^2.0.5"
  }
}
